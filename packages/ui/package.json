{
  "name": "@aakashiic/ui",
  "version": "0.1.0",
  "description": "Shared React components (shadcn/Radix) for Data Vault, V-Estate and the central portal",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "styles.css",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css",
    "./utils": {
      "types": "./dist/lib/utils.d.ts",
      "default": "./dist/lib/utils.js"
    },
    "./*": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/clean.js && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/*.test.js\" && vitest run",
    "preview": "vite --config preview/vite.config.ts",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AakashIIC/design-system.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.3.8"
  },
  "peerDependencies": {
    "cmdk": "^1.1.1",
    "lucide-react": ">=0.400.0",
    "react": "^19.0.0",
    "react-day-picker": "^9.9.0 || ^10.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.62.0",
    "recharts": "^2.15.4 || ^3.0.0",
    "tailwindcss": "^4.1.0",
    "vaul": "^1.1.2"
  },
  "peerDependenciesMeta": {
    "cmdk": {
      "optional": true
    },
    "react-day-picker": {
      "optional": true
    },
    "react-hook-form": {
      "optional": true
    },
    "recharts": {
      "optional": true
    },
    "vaul": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aakashiic/tokens": "^0.5.0",
    "@tailwindcss/cli": "^4.1.18",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.1",
    "cmdk": "^1.1.1",
    "jsdom": "^31.0.1",
    "lucide-react": "^0.540.0",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.62.0",
    "recharts": "^3.11.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vaul": "^1.1.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
