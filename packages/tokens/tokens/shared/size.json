{
  "spacing": {
    "1":  { "$type": "dimension", "$value": "4px" },
    "2":  { "$type": "dimension", "$value": "8px" },
    "3":  { "$type": "dimension", "$value": "12px" },
    "4":  { "$type": "dimension", "$value": "16px" },
    "5":  { "$type": "dimension", "$value": "20px" },
    "6":  { "$type": "dimension", "$value": "24px" },
    "8":  { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" }
  },
  "control": {
    "height": {
      "sm": { "$type": "dimension", "$value": "32px" },
      "md": { "$type": "dimension", "$value": "40px", "$description": "Default input/button height" },
      "lg": { "$type": "dimension", "$value": "48px" }
    }
  },
  "radius": {
    "sm":   { "$type": "dimension", "$value": "4px",  "$description": "Tags, small chips (Tailwind's rounded / rounded-sm)" },
    "md":   { "$type": "dimension", "$value": "6px",  "$description": "Small controls, chips" },
    "lg":   { "$type": "dimension", "$value": "8px",  "$description": "Buttons, inputs (most used in Data Vault)" },
    "xl":   { "$type": "dimension", "$value": "12px", "$description": "Cards, panels" },
    "2xl":  { "$type": "dimension", "$value": "16px", "$description": "Large cards, modals" },
    "full": { "$type": "dimension", "$value": "9999px" }
  }
}
