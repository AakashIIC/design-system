{
  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": ["Geist", "system-ui", "sans-serif"], "$description": "Phase 0: Geist for all apps" }
    },
    "size": {
      "2xs":  { "$type": "dimension", "$value": "11px", "$description": "Dense data UI only (chart labels, badges, table meta). Smallest allowed size" },
      "xs":   { "$type": "dimension", "$value": "12px", "$description": "Smallest size for running text" },
      "sm":   { "$type": "dimension", "$value": "14px", "$description": "Default UI text in Data Vault" },
      "base": { "$type": "dimension", "$value": "16px" },
      "lg":   { "$type": "dimension", "$value": "18px" },
      "xl":   { "$type": "dimension", "$value": "20px" },
      "2xl":  { "$type": "dimension", "$value": "24px" },
      "3xl":  { "$type": "dimension", "$value": "30px" },
      "4xl":  { "$type": "dimension", "$value": "36px", "$description": "Display: hero numbers and KPI values" },
      "5xl":  { "$type": "dimension", "$value": "48px", "$description": "Display: large hero numbers" },
      "6xl":  { "$type": "dimension", "$value": "60px", "$description": "Display: largest hero numbers" }
    },
    "weight": {
      "regular":  { "$type": "fontWeight", "$value": 400 },
      "medium":   { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold":     { "$type": "fontWeight", "$value": 700, "$description": "Kept: 321 uses in Data Vault. Plan asked for 3 weights; needs sign-off" }
    }
  }
}
